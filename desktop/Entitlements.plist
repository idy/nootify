<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The bundler signs every executable with the hardened runtime and these entitlements.
       The bundled Node.js (Contents/MacOS/node) needs JIT pages for V8; without this it aborts at startup. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
