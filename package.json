{
  "name": "nootify",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Routes Feishu replies to local coding-agent sessions and tracks pull requests, with a Windows and macOS tray app",
  "scripts": {
    "build": "node scripts/build-ui.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node scripts/test.mjs && go test ./internal/... ./desktop/...",
    "test:integration": "npm run build && node scripts/integration.mjs",
    "start": "go run ./desktop serve",
    "cli": "go run ./desktop",
    "core:test": "go test ./native/core/...",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:test": "npm run build && go test ./desktop/...",
    "desktop:stage": "npm run build && node scripts/stage-service.mjs",
    "desktop:build": "node scripts/desktop.mjs build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "linkedom": "0.18.15",
    "typescript": "7.0.2"
  }
}
