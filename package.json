{
  "name": "nootify",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "description": "Routes Feishu, Slack and Telegram replies to local coding-agent sessions and tracks pull requests, with a macOS tray app",
  "exports": {
    ".": {
      "types": "./dist/src/client.d.ts",
      "import": "./dist/src/client.js"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js scripts/*.test.mjs",
    "start": "node dist/src/server.js",
    "cli": "node dist/src/cli.js",
    "tauri": "tauri",
    "tailscale:build": "node scripts/build-tsnet.mjs",
    "desktop:dev": "npm run tailscale:build && node scripts/desktop.mjs dev",
    "desktop:stage": "npm run build && node scripts/stage-service.mjs",
    "desktop:build": "node scripts/desktop.mjs build --bundles app,dmg"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@opencode-ai/sdk": "1.19.5",
    "qrcode": "1.5.4",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "linkedom": "0.18.15",
    "typescript": "7.0.2"
  }
}
