{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nootify",
  "version": "../package.json",
  "identifier": "dev.idy.nootify",
  "build": {
    "frontendDist": "../desktop",
    "beforeBuildCommand": "npm run build && node scripts/stage-service.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "no-webview-ipc",
          "description": "All native actions are handled by Rust menus; no page receives IPC permissions.",
          "windows": ["main"],
          "local": false,
          "permissions": []
        }
      ],
      "csp": "default-src 'self'; script-src 'none'; style-src 'self'; img-src 'self'; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Feishu-to-agent message bridge and pull request monitor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/service/": "service/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/idy/nootify/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5QzdDRERFNDgzQjkyNUIKUldSYmtqdEkzczNIK2V1eXVnQzBmR1I5Z3VTRW13eHV0Q2lGRGk5SU51YVlLaDV3eFhqUXl5V0MK"
    }
  }
}
