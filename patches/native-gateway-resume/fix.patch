+)
+
+type recoveryDaemon struct {
+	owner      *Owner
+	server     *httptest.Server
+	grants     atomic.Int32
+	challenges atomic.Int32
+}
+
+func newRecoveryDaemon(t *testing.T, address string, next http.Handler, intercept func(http.ResponseWriter, *http.Request, http.Handler) bool) *recoveryDaemon {
+	t.Helper()
+	d := &recoveryDaemon{owner: NewOwner(strings.Repeat("a", 64))}
+	if next == nil {
+		next = http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if !Authenticated(r) {
+				t.Error("operation lost owner authorization")
+			}
+			httpx.JSON(w, 200, map[string]bool{"editable": true})
+		})
+	}
+	wrapped := d.owner.Wrap(next)
+	d.server = httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/ui/api/auth/challenge":
+			d.challenges.Add(1)
+		case "/ui/api/auth/grant":
+			d.grants.Add(1)
+		}
+		if intercept != nil && intercept(w, r, wrapped) {
+			return
+		}
+		wrapped.ServeHTTP(w, r)
+	}))
+	if address != "" {
+		_ = d.server.Listener.Close()
+		listener, err := net.Listen("tcp4", address)
+		if err != nil {
+			t.Fatal(err)
+		}
+		d.server.Listener = listener
+	}
+	d.server.Config.ConnContext = d.owner.ConnContext
+	d.server.Config.ConnState = d.owner.ConnState
+	d.server.Start()
+	t.Cleanup(d.server.Close)
+	return d
+}
+
+func recoveryGateway(t *testing.T, base string) (*Gateway, *Client) {
+	t.Helper()
+	g, err := NewGateway(context.Background(), Options{BaseURL: base, Token: strings.Repeat("a", 64), Assets: fstest.MapFS{"index.html": {Data: []byte("trusted-ui")}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = g.Close() })
+	browser, err := NewClient(strings.TrimRight(g.Origin(), "/"), g.capability)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = browser.Close() })
+	return g, browser
+}
+
+func expireDaemonLease(d *recoveryDaemon) {
+	d.owner.sessions.mu.Lock()
+	defer d.owner.sessions.mu.Unlock()
+	for _, session := range d.owner.sessions.entries {
+		session.seen = time.Now().Add(-10 * time.Minute)
+	}
+}
+
+func readRecoveryResponse(t *testing.T, browser *Client, method string, want int) string {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	response, err := browser.Fetch(ctx, Operation{Method: method, Path: "/ui/api/providers"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	body, err := io.ReadAll(response.Body)
+	if err != nil || response.StatusCode != want {
+		t.Fatalf("response status=%d body=%s error=%v, want %d", response.StatusCode, body, err, want)
+	}
+	return string(body)
+}
+
+func TestGatewayFirstReadAfterDaemonRestart(t *testing.T) {
+	d := newRecoveryDaemon(t, "", nil, nil)
+	_, browser := recoveryGateway(t, d.server.URL)
+	readRecoveryResponse(t, browser, "GET", 200)
+	address := d.server.Listener.Addr().String()
+	d.server.Close()
+	replacement := newRecoveryDaemon(t, address, nil, nil)
+	readRecoveryResponse(t, browser, "GET", 200)
+	if replacement.grants.Load() != 1 {
+		t.Fatalf("replacement grants=%d", replacement.grants.Load())
+	}
+}
+
+func TestGatewayConcurrentIdleRecoverySharesSession(t *testing.T) {
+	d := newRecoveryDaemon(t, "", nil, nil)
+	g, browser := recoveryGateway(t, d.server.URL)
+	old := g.upstream
+	expireDaemonLease(d)
+	start := make(chan struct{})
+	var workers sync.WaitGroup
+	for i := 0; i < 24; i++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			<-start
+			readRecoveryResponse(t, browser, "GET", 200)
+		}()
+	}
+	close(start)
+	workers.Wait()
+	if d.grants.Load() != 2 {
+		t.Fatalf("concurrent recovery issued %d sessions, want 2 including initial", d.grants.Load())
+	}
+	g.retire(old) // A delayed failure from the old generation cannot revoke the new one.
+	readRecoveryResponse(t, browser, "GET", 200)
+	if d.grants.Load() != 2 {
+		t.Fatal("late failure discarded the replacement session")
+	}
+}
+
+func TestGatewayRecoveryFailureIsBounded(t *testing.T) {
+	for _, failProof := range []bool{false, true} {
+		t.Run(map[bool]string{false: "fresh transport fails", true: "fresh proof fails"}[failProof], func(t *testing.T) {
+			var failed atomic.Bool
+			d := newRecoveryDaemon(t, "", nil, func(w http.ResponseWriter, r *http.Request, _ http.Handler) bool {
+				if failed.Load() && (r.URL.Path == "/ui/api/secure" || failProof && r.URL.Path == "/ui/api/auth/challenge") {
+					httpx.JSON(w, 503, map[string]string{"error": "unavailable"})
+					return true
+				}
+				return false
+			})
+			_, browser := recoveryGateway(t, d.server.URL)
+			failed.Store(true)
+			readRecoveryResponse(t, browser, "GET", 502)
+			if !browser.Healthy() || d.challenges.Load() != 2 {
+				t.Fatalf("unbounded recovery or lost browser session: challenges=%d", d.challenges.Load())
+			}
+			failed.Store(false)
+			readRecoveryResponse(t, browser, "GET", 200)
+		})
+	}
+}
+
+func TestGatewayNeverReplaysMutationWithLostResponse(t *testing.T) {
+	var writes atomic.Int32
+	var loseResponse atomic.Bool
+	d := newRecoveryDaemon(t, "", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == "POST" {
+			writes.Add(1)
+		}
+		httpx.JSON(w, 200, map[string]bool{"saved": true})
+	}), func(w http.ResponseWriter, r *http.Request, wrapped http.Handler) bool {
+		if r.URL.Path != "/ui/api/secure" || !loseResponse.Swap(false) {
+			return false
+		}
+		// Execute the mutation, then lose its entire authenticated response.
+		wrapped.ServeHTTP(httptest.NewRecorder(), r)
+		w.WriteHeader(502)
+		return true
+	})
+	_, browser := recoveryGateway(t, d.server.URL)
+	loseResponse.Store(true)
+	readRecoveryResponse(t, browser, "POST", 502)
+	if writes.Load() != 1 || d.grants.Load() != 1 {
+		t.Fatalf("mutation replayed: writes=%d grants=%d", writes.Load(), d.grants.Load())
+	}
+	readRecoveryResponse(t, browser, "GET", 200)
+	if writes.Load() != 1 {
+		t.Fatal("recovery replayed a prior mutation")
+	}
+}
+
+func TestGatewayExpiredMutationRequiresExplicitRetry(t *testing.T) {
+	var writes atomic.Int32
+	d := newRecoveryDaemon(t, "", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == "POST" {
+			writes.Add(1)
+		}
+		httpx.JSON(w, 200, map[string]bool{"saved": true})
+	}), nil)
+	_, browser := recoveryGateway(t, d.server.URL)
+	expireDaemonLease(d)
+	readRecoveryResponse(t, browser, "POST", 502)
+	if writes.Load() != 0 || d.grants.Load() != 1 {
+		t.Fatal("expired POST was automatically replayed")
+	}
+	readRecoveryResponse(t, browser, "POST", 200)
+	if writes.Load() != 1 || d.grants.Load() != 2 {
+		t.Fatal("explicit POST retry did not reconnect once")
+	}
+}
