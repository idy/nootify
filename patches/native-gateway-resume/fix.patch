+// A late failure from an old request must not retire the replacement session.
+func (g *Gateway) retire(active *Client) {
+	g.connMu.Lock()
+	if g.upstream != active {
+		g.connMu.Unlock()
+		return
+	}
+	g.upstream = nil
+	g.connMu.Unlock()
+	_ = active.Close()
+}
