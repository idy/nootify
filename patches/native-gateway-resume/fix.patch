+func TestGatewayAuthenticatedErrorIsNotRetried(t *testing.T) {
+	var calls atomic.Int32
+	d := newRecoveryDaemon(t, "", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		httpx.JSON(w, 503, map[string]string{"error": "business failure"})
+	}), nil)
+	_, browser := recoveryGateway(t, d.server.URL)
+	readRecoveryResponse(t, browser, "GET", 503)
+	if calls.Load() != 1 || d.grants.Load() != 1 {
+		t.Fatal("authenticated error was retried")
+	}
+}
+
+func TestGatewayStartedStreamIsNotReplayed(t *testing.T) {
+	var calls atomic.Int32
+	var truncate atomic.Bool
+	d := newRecoveryDaemon(t, "", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		_, _ = io.WriteString(w, "first chunk")
+		w.(http.Flusher).Flush()
+		_, _ = io.WriteString(w, "last chunk")
+	}), func(w http.ResponseWriter, r *http.Request, wrapped http.Handler) bool {
+		if r.URL.Path != "/ui/api/secure" || !truncate.Swap(false) {
+			return false
+		}
+		recorded := httptest.NewRecorder()
+		wrapped.ServeHTTP(recorded, r)
+		for key, values := range recorded.Header() {
+			w.Header()[key] = values
+		}
+		frames := strings.Split(recorded.Body.String(), "\n")
+		// Forward verified headers and data, but omit the authenticated END.
+		_, _ = io.WriteString(w, strings.Join(frames[:2], "\n")+"\n")
+		return true
+	})
+	_, browser := recoveryGateway(t, d.server.URL)
+	truncate.Store(true)
+	body := readRecoveryResponse(t, browser, "GET", 200)
+	if body != "first chunk" || calls.Load() != 1 || d.grants.Load() != 1 {
+		t.Fatalf("stream was replayed: body=%q calls=%d grants=%d", body, calls.Load(), d.grants.Load())
+	}
+	readRecoveryResponse(t, browser, "GET", 200)
+	if d.grants.Load() != 2 {
+		t.Fatal("next request did not retire the broken stream connection")
+	}
+}
+
+type recoveryRoundTripper func(*http.Request) (*http.Response, error)
+
+func (f recoveryRoundTripper) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestGatewayCancellationDoesNotRecoverOrRetireSession(t *testing.T) {
+	d := newRecoveryDaemon(t, "", nil, nil)
+	g, browser := recoveryGateway(t, d.server.URL)
+	active := g.upstream
+	transport := active.http.Transport
+	started := make(chan struct{})
+	var once sync.Once
+	active.http.Transport = recoveryRoundTripper(func(r *http.Request) (*http.Response, error) {
+		once.Do(func() { close(started) })
+		<-r.Context().Done()
+		return nil, r.Context().Err()
+	})
+	ctx, cancel := context.WithCancel(context.Background())
+	finished := make(chan struct{})
+	go func() {
+		defer close(finished)
+		g.proxy(httptest.NewRecorder(), httptest.NewRequestWithContext(ctx, "GET", "/ui/api/providers", nil))
+	}()
+	<-started
+	cancel()
+	select {
+	case <-finished:
+	case <-time.After(time.Second):
+		t.Fatal("cancelled request did not stop promptly")
+	}
+	active.http.Transport = transport
+	if g.upstream != active || !active.Healthy() || d.grants.Load() != 1 {
+		t.Fatal("cancellation retired or reauthorized a healthy session")
+	}
+	readRecoveryResponse(t, browser, "GET", 200)
+}
+
+func TestGatewayCancelledWaiterDoesNotBootstrap(t *testing.T) {
+	d := newRecoveryDaemon(t, "", nil, nil)
+	g, _ := recoveryGateway(t, d.server.URL)
+	g.connMu.Lock()
+	ctx, cancel := context.WithCancel(context.Background())
+	finished := make(chan error, 1)
+	go func() { _, err := g.connection(ctx); finished <- err }()
+	cancel()
+	g.connMu.Unlock()
+	if err := <-finished; !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancelled connection returned %v", err)
+	}
+	if d.grants.Load() != 1 {
+		t.Fatal("cancelled waiter created a new session")
+	}
+}
+
+func TestGatewayCancellationDuringRecoveryProof(t *testing.T) {
+	for _, closeGateway := range []bool{false, true} {
+		t.Run(map[bool]string{false: "request cancelled", true: "gateway closed"}[closeGateway], func(t *testing.T) {
+			var block atomic.Bool
+			started := make(chan struct{})
+			var once sync.Once
+			d := newRecoveryDaemon(t, "", nil, func(w http.ResponseWriter, r *http.Request, _ http.Handler) bool {
+				if r.URL.Path != "/ui/api/auth/challenge" || !block.Load() {
+					return false
+				}
+				once.Do(func() { close(started) })
+				<-r.Context().Done()
+				return true
+			})
+			g, _ := recoveryGateway(t, d.server.URL)
+			expireDaemonLease(d)
+			block.Store(true)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			finished := make(chan struct{})
+			go func() {
+				defer close(finished)
+				g.proxy(httptest.NewRecorder(), httptest.NewRequestWithContext(ctx, "GET", "/ui/api/providers", nil))
+			}()
+			select {
+			case <-started:
+			case <-time.After(time.Second):
+				t.Fatal("recovery proof did not start")
+			}
+			if closeGateway {
+				_ = g.Close()
+			} else {
+				cancel()
+			}
+			select {
+			case <-finished:
+			case <-time.After(time.Second):
+				t.Fatal("cancellation did not stop recovery proof")
+			}
+			if d.challenges.Load() != 2 || d.grants.Load() != 1 {
+				t.Fatal("cancelled proof issued or retried a session")
+			}
+		})
+	}
+}
